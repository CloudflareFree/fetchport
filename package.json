{
  "name": "fetchport",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub / Docker / SourceForge 加速网关，部署于 Cloudflare 边缘网络",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public --project-name=fetchport",
    "test": "node test/integration.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:all": "node test/integration.mjs && node test/e2e.mjs",
    "seo:submit": "node scripts/search-console.mjs submit",
    "seo:status": "node scripts/search-console.mjs status",
    "seo:inspect": "node scripts/search-console.mjs inspect",
    "build": "echo 'FetchPort: static assets + Pages Functions, no build step required'"
  },
  "type": "module",
  "optionalDependencies": {
    "wrangler": "^4.154.0"
  }
}
